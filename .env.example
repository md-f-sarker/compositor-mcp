# Override the bridge discovery file written by the Compositor app.
# COMPOSITOR_MCP_BRIDGE_FILE=/Users/you/Library/Application Support/Compositor/MCP/bridge.json

# Run against the deterministic in-memory mock instead of the macOS app.
# COMPOSITOR_MCP_MOCK=1

# Timeout for one bridge request in milliseconds.
# COMPOSITOR_MCP_TIMEOUT_MS=30000
