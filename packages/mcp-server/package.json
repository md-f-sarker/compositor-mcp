{
  "name": "compositor-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol integration for the Compositor macOS image editor: stdio MCP server plus doctor, install-bridge and configure CLI helpers",
  "type": "module",
  "bin": {
    "compositor-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "dev": "COMPOSITOR_MCP_MOCK=1 tsx src/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node scripts/sync-package-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@compositor-mcp/protocol": "0.1.0",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-f-sarker/compositor-mcp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/md-f-sarker/compositor-mcp#readme",
  "bugs": "https://github.com/md-f-sarker/compositor-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compositor",
    "image-editor",
    "macos",
    "ai-agent",
    "claude",
    "codex"
  ],
  "publishConfig": {
    "access": "public"
  }
}
