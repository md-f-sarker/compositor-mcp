{
  "name": "@compositor-mcp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "compositor-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
